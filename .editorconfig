# Formato común para todos los editores (sección 3 de ESTANDARES.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.{csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
